# Configuration keys template for SACU

# FastAPI Backend Config
PROJECT_NAME="SACU - Sistema Académico Unificado"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="your-secret-key-here"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Server settings
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Config
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sacu_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sacu_db

# Frontend Config
VITE_API_URL=http://localhost:8000/api/v1

# Google Drive Scanning Config
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_optional
GOOGLE_DRIVE_CREDENTIALS_FILE=path/to/credentials.json

# Supabase Config (Profesores & CsP en Netlify)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_USER_EMAIL=user@example.com
VITE_SUPABASE_USER_PASSWORD=your_user_password_here


